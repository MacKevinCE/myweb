---
import SectionHeader from './SectionHeader.astro';
import ImageWithFallback from '../shared/ImageWithFallback.astro';
import { cycleColor } from '../../utils/colors';
import type { TerminalContent } from '../../types';

interface Props {
  content: TerminalContent;
}

const { content } = Astro.props;
const { about } = content;
const brand = (content.about?.avatarName ?? '')
  .toLowerCase()
  .replace(/\s+/g, '_');
const avatarLabel = (about.avatarLabel ?? '> {brand}.profile').replace(
  '{brand}',
  brand
);
---

<section
  id="about"
  class="bg-[var(--bg-primary)] font-mono"
  style="padding: var(--section-padding-y) var(--section-padding-x);"
>
  <div class="flex flex-col gap-12">
    <SectionHeader command={about.command} />

    <!-- Content -->
    <div class="flex flex-col lg:flex-row gap-16">
      <!-- Left: Avatar image -->
      <div class="flex flex-col items-center gap-6 lg:w-[320px] shrink-0">
        <div
          class="w-[240px] h-[240px] border-2 border-[var(--green-terminal)] bg-[var(--bg-surface)] flex items-center justify-center overflow-hidden relative"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-[var(--green-terminal)] to-[var(--cyan-accent)] opacity-10"
          >
          </div>
          <ImageWithFallback
            src={about.avatarUrl}
            alt={about.avatar}
            fallback={about.avatar}
          />
        </div>
        <span
          class="terminal-line text-[var(--green-terminal)] text-xs font-mono"
          >{avatarLabel}</span
        >
      </div>

      <!-- Right: Bio + Stats -->
      <div class="flex flex-col gap-8 flex-1">
        <!-- Title -->
        <h3 class="terminal-line text-[var(--text-primary)] text-xl font-bold">
          {about.bioTitle}
        </h3>

        <!-- Bio -->
        <div class="flex flex-col gap-4">
          {
            about.bio.map((paragraph) => (
              <p class="terminal-line text-[var(--text-secondary)] text-sm leading-[1.7] font-secondary">
                {paragraph}
              </p>
            ))
          }
        </div>

        <!-- Metrics row -->
        <div class="terminal-line flex justify-between w-full">
          {
            about.metrics.map((m, i) => (
              <div
                class={`flex flex-col gap-1.5 w-[160px] py-5 ${i > 0 ? 'border-l border-[var(--border-primary)] pl-5' : ''}`}
              >
                <span
                  class="text-[40px] font-bold font-mono"
                  style={`color: ${cycleColor(i)}`}
                >
                  {m.value}
                </span>
                <span class="text-[var(--text-secondary)] text-xs font-secondary">
                  {m.label}
                </span>
              </div>
            ))
          }
        </div>

        <!-- Language badges -->
        <div class="terminal-line flex flex-wrap items-center gap-3">
          <span class="text-[var(--text-muted)] text-xs font-mono"
            >{about.langLabel}</span
          >
          {
            about.languages.map((lang, i) => (
              <span
                class="px-3 py-1.5 text-[11px] font-mono"
                style={`color: ${cycleColor(i)}; border: 1px solid ${cycleColor(i)};`}
              >
                {lang.text}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
