---
import { cycleColor } from '../../utils/colors';
import type { TerminalContent, CodeBlockLine } from '../../types';

interface Props {
  content: TerminalContent;
}

const { content } = Astro.props;
const { hero } = content;
const heroName = (content.about?.avatarName ?? '').toUpperCase();
const codeBlock: CodeBlockLine[] = content.codeBlock ?? [];
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col justify-center overflow-hidden"
  style="background: var(--bg-hero);"
>
  <!-- Scanline overlay -->
  <div
    class="absolute inset-0 pointer-events-none opacity-30"
    style="background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(16,185,129,0.02) 2px, rgba(16,185,129,0.02) 4px);"
  >
  </div>

  <div class="relative z-10 px-[var(--section-padding-x)] pt-24">
    <!-- Boot lines -->
    <div class="flex flex-col gap-1 mb-12">
      {
        hero.bootLines.map((line) => (
          <span
            class={`terminal-line text-[11px] font-mono ${line.type === 'ok' ? 'text-[var(--green-terminal)]' : 'text-[var(--text-muted)]'}`}
          >
            {line.text}
          </span>
        ))
      }
    </div>

    <!-- Hero content -->
    <div class="flex flex-col gap-6 max-w-5xl">
      <span
        class="terminal-line text-sm font-mono font-medium text-[var(--green-terminal)]"
        >{hero.prompt}</span
      >

      <h1
        class="terminal-line text-5xl sm:text-7xl md:text-8xl lg:text-[96px] font-bold tracking-[8px] text-[var(--text-primary)] font-mono glitch-text"
        data-text={heroName}
      >
        {heroName}
      </h1>

      <div class="terminal-line flex items-center gap-3">
        <span
          class="text-[22px] font-bold text-[var(--green-terminal)] font-mono"
          >&gt;</span
        >
        <span class="text-[22px] text-[var(--cyan-accent)] font-secondary"
          >{hero.role}</span
        >
      </div>

      <p
        class="terminal-line text-[var(--text-secondary)] text-base font-secondary"
      >
        {hero.tagline}
      </p>

      <!-- Glow line -->
      <div
        class="terminal-line w-full max-w-[600px] h-px bg-gradient-to-r from-[var(--green-terminal)] to-transparent"
      >
      </div>

      <!-- CTA -->
      <div class="terminal-line flex flex-wrap items-center gap-4">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 px-7 py-3.5 bg-[var(--green-terminal)] text-[var(--bg-primary)] font-mono text-sm font-medium hover:brightness-110 transition-all glitch-hover"
        >
          <span class="font-bold">$</span>
          {hero.ctaPrimary}
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-7 py-3.5 border border-[var(--green-terminal)] text-[var(--green-terminal)] font-mono text-sm font-medium hover:bg-[var(--green-terminal)] hover:text-[var(--bg-primary)] transition-all glitch-hover"
        >
          <span class="font-bold">↓</span>
          {hero.ctaSecondary}
        </a>
      </div>
    </div>

    <!-- Floating code block (desktop only) -->
    <div
      class="hidden xl:block absolute right-[var(--section-padding-x)] top-1/3 w-[460px] bg-[var(--bg-elevated)]/70 border border-[var(--border-primary)] p-6"
    >
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[var(--text-muted)] text-[11px] font-mono"
          >{hero.codeBlockFile}</span
        >
      </div>
      <div class="flex flex-col gap-1.5">
        {codeBlock.map((line) => (
          <div class="terminal-code-line terminal-line">
            {line.map((tk) =>
              tk.c
                ? <span class={`terminal-code-${tk.c}`}>{tk.t}</span>
                : <span>{tk.t}</span>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Status Bar -->
    <div class="flex flex-wrap items-center gap-10 mt-16 mb-8">
      {
        (content.about?.statusBar ?? []).map((item, i) => (
          <div class="terminal-line flex items-center gap-2">
            <span
              class="w-2 h-2 rounded-full shrink-0"
              style={`background: ${cycleColor(i)}`}
            />
            <span class="text-[var(--text-secondary)] font-mono text-xs">
              {item.key.replace(/\s+/g, '_')}: {item.value.replace(/\s+/g, '_').replace(/_\/_/g, ' / ')}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="flex flex-col items-center gap-2 absolute bottom-3 left-1/2 -translate-x-1/2"
  >
    <div
      class="w-px h-10 bg-gradient-to-b from-transparent to-[var(--green-terminal)]"
    >
    </div>
    <div class="w-1.5 h-1.5 rounded-full bg-[var(--green-terminal)]"></div>
  </div>

  <!-- Bottom glow -->
  <div
    class="absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-[var(--green-terminal)] to-transparent"
  >
  </div>
</section>
