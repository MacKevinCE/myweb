---
import type { TerminalContent } from '../../types';

interface Props {
  content: TerminalContent;
}

const { content } = Astro.props;
const bootLines = content.hero.bootLines;
---

<div id="boot-overlay" class="boot-overlay">
  <div class="font-mono">
    {
      bootLines.map((line) => (
        <div class={`boot-line ${line.type}`}>{line.text}</div>
      ))
    }
    <div class="boot-line accent mt-6">
      {content.hero.bootReady}<span class="caret ml-1"></span>
    </div>
  </div>
</div>
