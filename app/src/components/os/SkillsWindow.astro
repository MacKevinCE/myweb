---
import { windowTitles, W } from '../../data/os-apps';
import WindowChrome from './shared/WindowChrome.astro';
import type { OsContent } from '../../types';

interface Props {
  content: OsContent;
}

const { content } = Astro.props;

const categoryIcons = ['code', 'layers', 'library', 'boxes', 'flask', 'wrench', 'rocket'];

const icons: Record<string, string> = {
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  layers: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 12.5-8.58 3.91a2 2 0 0 1-1.66 0L2 12.5"/><path d="m22 17-8.58 3.91a2 2 0 0 1-1.66 0L2 17"/>',
  library: '<path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/>',
  boxes: '<path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 1 9.03 3.8l2.14-1.28a2 2 0 0 1 2.06 0l2.14 1.28a2 2 0 0 1 .97 1.71V10L12 13.5 7 10V5.42a1 1 0 0 1 0-.29 1 1 0 0 1 0-.29l.97-.42Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/>',
  flask: '<path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/><path d="M7 16.5h10"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  rocket: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
};

const dotColors = [
  'var(--os-green-from)',
  'var(--os-cyan-from)',
  'var(--palette-2)',
  'var(--os-pink-from)',
  'var(--os-purple-from)',
  'var(--os-orange-from)',
  'var(--os-blue-from)',
];

const categories = content.skills?.categories ?? [];

const navItems = categories.map((cat, i) => ({
  key: `cat-${i}`,
  label: cat.title,
  icon: categoryIcons[i] ?? 'code',
  color: 'var(--os-purple-from)',
}));
---

<div
  class="os-window os-window--skills"
  id="skills-window"
  style="display: none;"
>
  <WindowChrome title={windowTitles[W.SKILLS]} windowId="skills" titleClass="os-window-title--inter" />

  <!-- Window Body -->
  <div class="os-window-body">
    <!-- Sidebar -->
    <nav class="os-sidebar">
      {navItems.map((nav, i) => (
        <button
          class={`os-nav ${i === 0 ? 'os-nav--active' : ''}`}
          data-skills-tab={nav.key}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="os-nav-icon">
            <Fragment set:html={icons[nav.icon]} />
          </svg>
          <span class="os-nav-text">{nav.label}</span>
        </button>
      ))}
    </nav>

    <!-- Content -->
    <div class="skills-content">
      <!-- Fixed header per tab -->
      {categories.map((cat, catIdx) => {
        const key = navItems[catIdx]?.key ?? `cat-${catIdx}`;
        const navItem = navItems[catIdx];
        return (
          <div class={`skills-header-block ${catIdx === 0 ? 'skills-header-block--active' : ''}`} data-skills-header={key}>
            <div class="skills-content-header">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style={`color: ${navItem?.color ?? 'var(--os-purple-from)'};`}>
                <Fragment set:html={icons[navItem?.icon ?? 'code']} />
              </svg>
              <span class="skills-content-title">{navItem?.label ?? cat.title}</span>
            </div>
            <div class="os-divider" />
          </div>
        );
      })}

      <!-- Scrollable items per tab -->
      <div class="skills-scroll">
        {categories.map((cat, catIdx) => {
          const key = navItems[catIdx]?.key ?? `cat-${catIdx}`;
          return (
            <div class={`skills-panel ${catIdx === 0 ? 'skills-panel--active' : ''}`} data-skills-panel={key}>
              {(cat.items ?? []).map((item, itemIdx) => (
                <div class="skills-card">
                  <div class="skills-card-dot" style={`background: ${dotColors[itemIdx % dotColors.length]};`} />
                  <span class="skills-card-name">{item.name}</span>
                </div>
              ))}
            </div>
          );
        })}
      </div>
    </div>
  </div>
</div>
