---
import { windowTitles, W, uiIcons } from '../../data/os-apps';
import WindowChrome from './shared/WindowChrome.astro';
import ImageWithFallback from '../shared/ImageWithFallback.astro';
import type { OsContent } from '../../types';

interface Props {
  content: OsContent;
}

const { content } = Astro.props;
const name = content.about?.avatarName ?? 'Mac Kevin';
const role = content.about?.role ?? 'Senior iOS Developer';
const avatarUrl = content.about?.avatarUrl ?? '';

const as = content.appStore ?? {};
const asStats = as.stats ?? {};

/* ---- Nav items ---- */
const navIcons: Record<string, string> = {
  'layout-grid': '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>',
  'landmark':    '<line x1="3" x2="3" y1="22" y2="12"/><line x1="9" x2="9" y1="22" y2="8"/><line x1="15" x2="15" y1="22" y2="2"/><line x1="21" x2="21" y1="22" y2="14"/>',
  'heart-pulse': '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
  'palette':     '<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>',
};

const sidebarNav = [
  { icon: 'layout-grid', label: as.navAll ?? 'All',                 key: 'all' },
  { icon: 'heart-pulse', label: as.navOpenSource ?? 'Open Source',  key: 'open-source' },
  { icon: 'palette',     label: as.navPortfolio ?? 'Portfolio',     key: 'portfolio' },
];

/* ---- Build projects array from profile data ---- */
const featured = content.projects?.featured;
const items = content.projects?.items ?? [];

interface AppProject {
  name: string;
  shortDesc: string;
  category: string;
  description: string;
  tags: string[];
  image?: string;
  repo: string;
}

const allProjects: AppProject[] = [
  ...(featured ? [{
    name: featured.name,
    shortDesc: featured.shortDesc ?? '',
    category: featured.category ?? '',
    description: featured.description ?? '',
    tags: featured.tags ?? [],
    image: featured.image,
    repo: featured.repo ?? '',
  }] : []),
  ...items.map(item => ({
    name: item.name,
    shortDesc: item.shortDesc ?? '',
    category: item.category ?? '',
    description: item.description ?? '',
    tags: item.tags ?? [],
    image: item.image,
    repo: item.repo ?? '',
  })),
];

/* ---- Gradient / shadow by category ---- */
const categoryStyles: Record<string, { gradient: string; shadow: string }> = {
  enterprise:  { gradient: 'os-gradient-blue',   shadow: 'os-shadow-blue' },
  'open-source': { gradient: 'os-gradient-green',  shadow: 'os-shadow-green' },
  portfolio:   { gradient: 'os-gradient-purple', shadow: 'os-shadow-purple' },
};

function getStyles(category: string) {
  return categoryStyles[category] ?? { gradient: 'os-gradient-slate', shadow: '' };
}
---

<div
  class="os-window os-window--appstore"
  id="app-store-window"
  style="display: none;"
>
  <WindowChrome title={windowTitles[W.APP_STORE]} windowId="app-store" titleClass="os-window-title--inter" />

  <!-- Body: Sidebar + Content -->
  <div class="os-window-body as-body">
    <!-- Sidebar -->
    <aside class="os-sidebar as-sidebar">
      <!-- Search -->
      <div class="as-search" id="as-search-bar">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <Fragment set:html={uiIcons.search} />
        </svg>
        <input
          type="text"
          class="as-search-input"
          id="as-search-input"
          placeholder={as.search ?? 'Search'}
          autocomplete="off"
        />
      </div>

      <div class="as-sidebar-spacer-sm"></div>

      <!-- Nav items -->
      {sidebarNav.map((item, idx) => (
        <button
          class:list={['os-nav', { 'os-nav--active': idx === 0 }]}
          data-as-category={item.key}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="os-nav-icon">
            <Fragment set:html={navIcons[item.icon]} />
          </svg>
          <span class="os-nav-text">{item.label}</span>
        </button>
      ))}

      <div class="as-sidebar-spacer"></div>

      <!-- User section -->
      <div class="stg-profile">
        <div class="stg-avatar">
          {avatarUrl && <img src={avatarUrl} alt={name} class="stg-avatar-img" />}
        </div>
        <div class="stg-profile-info">
          <span class="stg-profile-name">{name}</span>
          <span class="stg-profile-role">{role}</span>
        </div>
      </div>
    </aside>

    <!-- ===== CATEGORY VIEW (grid of apps) ===== -->
    <div class="as-content as-view" id="as-category-view">
      <h2 class="as-category-title" id="as-category-title">{as.navAll ?? 'All'}</h2>
      <div class="as-grid" id="as-grid">
        {allProjects.map((project, i) => {
          const styles = getStyles(project.category);
          return (
            <div class="as-card" data-as-index={i} data-as-category={project.category}>
              <div class:list={['as-card-icon', styles.gradient]}>
                <ImageWithFallback src={project.image} alt={project.name} fallback={project.name[0]} imgClass="as-card-img" fallbackClass="as-card-letter" />
              </div>
              <div class="as-card-info">
                <span class="as-card-name">{project.name}</span>
                <span class="as-card-desc">{project.shortDesc}</span>
                <div class="as-card-spacer"></div>
                <button class="as-card-btn as-card-open-btn">{as.open ?? 'Open'}</button>
              </div>
            </div>
          );
        })}
      </div>
      <div class="as-grid-empty" id="as-grid-empty" style="display:none;">
        <span class="as-grid-empty-text">{as.noAppsFound ?? 'No apps found'}</span>
      </div>
    </div>

    <!-- ===== DETAIL VIEW (single app) ===== -->
    <div class="as-content as-view" id="as-detail-view" style="display:none;">
      <!-- Back row -->
      <div class="as-back-row">
        <button class="as-back-btn" id="as-back-btn" aria-label="Back">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <Fragment set:html={uiIcons.chevronLeft} />
          </svg>
        </button>
        <button class="as-share-btn" id="as-share-btn" aria-label={as.share ?? 'Share'}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" x2="12" y1="2" y2="15"/>
          </svg>
        </button>
      </div>

      <!-- App header -->
      <div class="as-app-header">
        <div class="as-app-icon" id="as-detail-icon"></div>
        <div class="as-app-info">
          <h2 class="as-app-name" id="as-detail-name"></h2>
          <p class="as-app-desc" id="as-detail-desc"></p>
          <button class="as-get-btn" id="as-detail-btn">{as.open ?? 'Open'}</button>
        </div>
      </div>

      <div class="os-divider"></div>

      <!-- Stats row (hidden by default, shown by script if data exists) -->
      <div class="as-stats" id="as-detail-stats" style="display:none;"></div>

      <!-- Description -->
      <h3 class="as-section-title">{as.description ?? 'Description'}</h3>
      <p class="as-desc-text" id="as-detail-full-desc"></p>

      <div class="os-divider"></div>

      <!-- Screenshots (hidden by default, shown by script if data exists) -->
      <div class="as-preview" id="as-detail-preview" style="display:none;">
        <div class="as-preview-scroll" id="as-detail-screenshots"></div>
      </div>

      <!-- Tags -->
      <div class="as-tags" id="as-detail-tags"></div>

      <div class="os-divider"></div>

      <!-- Bottom row -->
      <div class="as-bottom-row">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="as-bottom-icon">
          <rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>
        </svg>
        <span class="as-bottom-label">{as.platform ?? 'Mac'}</span>
      </div>

      <div class="os-divider"></div>
    </div>
  </div>
</div>

<!-- Projects data for JS -->
<script is:inline id="as-projects" type="application/json" set:html={JSON.stringify(allProjects)} />
<!-- i18n data for JS -->
<script is:inline id="as-i18n" type="application/json" set:html={JSON.stringify({
  open: as.open ?? 'Open',
  share: as.share ?? 'Share',
  noAppsFound: as.noAppsFound ?? 'No apps found',
  navAll: as.navAll ?? 'All',
  navOpenSource: as.navOpenSource ?? 'Open Source',
  navPortfolio: as.navPortfolio ?? 'Portfolio',
  description: as.description ?? 'Description',
})} />
