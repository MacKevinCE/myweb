---
interface Props {
  title: string;
  windowId: string;
  titleClass?: string;
}

const { title, windowId, titleClass = '' } = Astro.props;
const titleCls = ['os-window-title', titleClass].filter(Boolean).join(' ');
---

<div class="os-window-titlebar" id={`${windowId}-titlebar`}>
  <div class="os-window-dots">
    <button
      class="os-dot os-dot--red"
      id={`${windowId}-close`}
      aria-label="Close"></button>
    <button
      class="os-dot os-dot--yellow"
      id={`${windowId}-minimize`}
      aria-label="Minimize"></button>
    <button
      class="os-dot os-dot--green"
      id={`${windowId}-fullscreen`}
      aria-label="Fullscreen"></button>
  </div>
  <span class={titleCls}>{title}</span>
  <div class="os-window-titlespacer"></div>
</div>
