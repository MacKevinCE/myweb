---
import { uiIcons } from '../../data/os-apps';
import type { OsContent } from '../../types';

interface Props {
  content: OsContent;
}

const { content } = Astro.props;
const menuItems: [string?] = []; //['File', 'Edit', 'View', 'Go', 'Help'];

const osMenuItems = [
  {
    icon: '<rect width="18" height="12" x="3" y="4" rx="2"/><path d="M7 8h.01"/><path d="M17 8h.01"/><path d="M7 12h.01"/><path d="M17 12h.01"/>',
    label: content.menuBar.aboutMac.replace('{name}', content.about.avatarName),
    action: 'about',
  },
  { separator: true },
  {
    icon: '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
    label: content.menuBar.settings,
    action: 'settings',
    shortcut: '⌘,',
  },
  {
    icon: '<path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><rect width="20" height="5" x="2" y="7" rx="1"/>',
    label: content.menuBar.appStore,
    action: 'appstore',
  },
  {
    icon: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>',
    label: content.menuBar.downloadCV,
    action: 'download-cv',
  },
  { separator: true },
  {
    icon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
    label: content.menuBar.sleep,
    action: 'sleep',
  },
  {
    icon: uiIcons.refreshCw,
    label: content.menuBar.restart,
    action: 'restart',
  },
  { icon: uiIcons.lock, label: content.menuBar.lockScreen, action: 'lock' },
];
---

<header class="os-menubar">
  <div class="os-menubar-left">
    <button
      class="os-mobile-back"
      id="os-mobile-back"
      aria-label={content.menuBar.back}
      style="display:none;"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <Fragment set:html={uiIcons.chevronLeft} />
      </svg>
    </button>
    <button class="os-menu-btn" id="os-menu-btn" aria-label="Menu">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 128 128"
        fill="none"
      >
        <rect
          x="8"
          y="20"
          width="112"
          height="96"
          rx="12"
          fill="currentColor"
          opacity="0.1"
          stroke="currentColor"
          stroke-width="3"
          stroke-opacity="0.4"></rect>
        <rect
          x="8"
          y="20"
          width="112"
          height="24"
          rx="12"
          fill="currentColor"
          opacity="0.15"></rect>
        <rect
          x="8"
          y="32"
          width="112"
          height="12"
          fill="currentColor"
          opacity="0.15"></rect>
        <circle cx="26" cy="32" r="5" fill="#ef4444"></circle>
        <circle cx="44" cy="32" r="5" fill="#fbbf24"></circle>
        <circle cx="62" cy="32" r="5" fill="#34d399"></circle>
        <text
          x="64"
          y="88"
          text-anchor="middle"
          font-family="system-ui,-apple-system,sans-serif"
          font-size="36"
          font-weight="700"
          fill="currentColor">MK</text
        >
      </svg>
    </button>
    <span class="os-menubar-app">{content.menuBar.defaultApp}</span>
    {menuItems.map((item) => <span class="os-menubar-item">{item}</span>)}
  </div>

  <!-- Status pill (mobile only) -->
  <div class="os-notch" aria-hidden="true"></div>

  <div class="os-menubar-right">
    <button
      class="os-menubar-fs-btn"
      id="os-fullscreen-btn"
      aria-label={content.menuBar.fullscreen}
      style="display:none;"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <Fragment set:html={uiIcons.fullscreen} />
      </svg>
    </button>
    <button
      class="os-menubar-icon-btn os-menubar-wifi"
      id="os-wifi-btn"
      data-open-window="speed-test-window"
      aria-label="Speed Test"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 20h.01"></path>
        <path
          class="mb-wifi-arc mb-wifi-arc-1"
          d="M2 8.82a15 15 0 0 1 20 0"
          opacity="0.25"></path>
        <path
          class="mb-wifi-arc mb-wifi-arc-2"
          d="M5 12.859a10 10 0 0 1 14 0"
          opacity="0.25"></path>
        <path
          class="mb-wifi-arc mb-wifi-arc-3"
          d="M8.5 16.429a5 5 0 0 1 7 0"
          opacity="0.25"></path>
      </svg>
      <span class="mb-wifi-badge" id="mb-wifi-badge">?</span>
      <span class="mb-wifi-tooltip" id="mb-wifi-tooltip"></span>
    </button>
    <button
      class="os-menubar-lang-btn"
      id="os-lang-btn"
      aria-label={content.menuBar.language}
    >
      <span class="os-menubar-lang-text" id="os-lang-text"></span>
    </button>
    <span
      class="os-menubar-clock"
      id="os-clock"
      style="font-variant-numeric: tabular-nums;"></span>
  </div>
</header>

<!-- OS Context Menu -->
<div class="os-menu" id="os-menu">
  {
    osMenuItems.map((item) =>
      item.separator ? (
        <div class="os-menu-separator" />
      ) : (
        <button class="os-menu-item" data-menu-action={item.action}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="os-menu-icon"
          >
            <Fragment set:html={item.icon} />
          </svg>
          <span class="os-menu-label">{item.label}</span>
          {item.shortcut && (
            <span class="os-menu-shortcut">{item.shortcut}</span>
          )}
        </button>
      )
    )
  }
</div>
<!-- Clock is managed by settingsTabs.ts -->
