---
/**
 * App Switcher overlay — desktop-style Alt+Tab window picker.
 * Rendered once in the page; JS populates it dynamically.
 */
---

<div class="app-switcher" id="app-switcher" style="display: none;">
  <div class="app-switcher-bar" id="app-switcher-bar"></div>
</div>

<style is:global>
  @import '../../styles/os/app-switcher.css';
</style>
