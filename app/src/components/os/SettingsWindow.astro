---
import {
  imageWallpapers,
  animationWallpapers,
  defaultWallpaper,
} from '../../data/os-wallpapers';
import { windowTitles, W } from '../../data/os-apps';
import WindowChrome from './shared/WindowChrome.astro';
import { languages } from '../../utils/i18n';
import type { OsContent } from '../../types';

interface Props {
  content: OsContent;
}

const { content } = Astro.props;
const stg = content.settings || {};
const userName = content.about?.avatarName;
const userRole = content.about?.role;
const avatarUrl = content.about?.avatarUrl ?? '';

const navItems = [
  {
    key: 'appearance',
    label: stg.navAppearance,
    icon: '<path d="m2 4 3 12h14l3-12"/><path d="m6 8 4 8"/><path d="m14 8-4 8"/>',
  },
  {
    key: 'dock',
    label: stg.navDesktopDock,
    icon: '<rect width="18" height="12" x="3" y="4" rx="2"/><path d="M7 8h.01"/><path d="M17 8h.01"/><path d="M7 12h.01"/><path d="M17 12h.01"/>',
  },
  {
    key: 'wallpaper',
    label: stg.navWallpaper,
    icon: '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>',
  },
  {
    key: 'datetime',
    label: stg.navDateTime,
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  },
  {
    key: 'language',
    label: stg.navLanguage,
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  },
  {
    key: 'accessibility',
    label: stg.navAccessibility,
    icon: '<circle cx="12" cy="4" r="1"/><path d="m6 9 3.5 1 3.5-1L16 9"/><path d="M12 10v4"/><path d="m8 22 2-6"/><path d="m14 22 2-6"/>',
  },
];

const accentColorVars = [
  'var(--os-stg-blue)',
  'var(--os-stg-purple)',
  'var(--os-stg-pink)',
  'var(--os-stg-red)',
  'var(--os-stg-amber)',
  'var(--os-stg-green)',
];
const accentColorNames = stg.accentColors ?? [];
const accentColors = accentColorVars.map((color, i) => ({
  color,
  name: accentColorNames[i] ?? '',
}));
---

<div
  class="os-window os-window--settings"
  id="settings-window"
  style="display: none;"
>
  <WindowChrome
    title={windowTitles[W.SETTINGS]}
    windowId="settings"
    titleClass="os-window-title--inter"
  />

  <!-- Window Body -->
  <div class="os-window-body">
    <!-- Sidebar -->
    <nav class="os-sidebar stg-sidebar">
      <!-- Profile -->
      <div class="stg-profile">
        <div class="stg-avatar">
          {
            avatarUrl && (
              <img
                src={avatarUrl}
                alt={userName || ''}
                class="stg-avatar-img"
              />
            )
          }
        </div>
        <div class="stg-profile-info">
          <span class="stg-profile-name">{userName}</span>
          <span class="stg-profile-role">{userRole}</span>
        </div>
      </div>
      <div class="stg-sidebar-spacer"></div>
      <!-- Nav items -->
      {
        navItems.map((nav, i) => (
          <button
            class={`os-nav ${i === 0 ? 'os-nav--active' : ''}`}
            data-stg-tab={nav.key}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="os-nav-icon"
            >
              <Fragment set:html={nav.icon} />
            </svg>
            <span class="os-nav-text">{nav.label}</span>
          </button>
        ))
      }
    </nav>

    <!-- Content panels -->
    <div class="stg-content">
      <!-- Appearance -->
      <div class="stg-panel stg-panel--active" data-stg-panel="appearance">
        <span class="stg-content-title">{stg.appearance}</span>
        <div class="os-divider"></div>

        <div class="stg-section">
          <span class="stg-section-label">{stg.appearance}</span>
          <div class="stg-themes">
            <button class="stg-theme" data-stg-theme="light">
              <div class="stg-theme-preview stg-theme-preview--light"></div>
              <span class="stg-theme-label">{stg.light}</span>
            </button>
            <button class="stg-theme" data-stg-theme="dark">
              <div class="stg-theme-preview stg-theme-preview--dark"></div>
              <span class="stg-theme-label">{stg.dark}</span>
            </button>
            <button class="stg-theme stg-theme--selected" data-stg-theme="auto">
              <div class="stg-theme-preview stg-theme-preview--auto">
                <div class="stg-theme-auto-left"></div>
                <div class="stg-theme-auto-right"></div>
              </div>
              <span class="stg-theme-label stg-theme-label--active"
                >{stg.auto}</span
              >
            </button>
          </div>
        </div>

        <div class="stg-color-row">
          <span class="stg-section-label">{stg.accentColor}</span>
          <div class="stg-color-dots">
            {
              accentColors.map((c, i) => (
                <button
                  class={`stg-color-dot ${i === 0 ? 'stg-color-dot--selected' : ''}`}
                  style={`--dot-clr: ${c.color}; background: var(--dot-clr);`}
                  data-stg-color={c.color}
                  aria-label={c.name}
                />
              ))
            }
          </div>
        </div>
      </div>

      <!-- Desktop & Dock -->
      <div class="stg-panel" data-stg-panel="dock">
        <span class="stg-content-title">{stg.navDesktopDock}</span>
        <div class="os-divider"></div>
        <!-- Mobile-only notice -->
        <div
          class="stg-mobile-note"
          id="stg-mobile-dock-note"
          style="display:none;"
        >
          <span>{stg.mobileDockNote}</span>
        </div>
        <div class="stg-section" id="stg-dock-section">
          <span class="stg-section-label">{stg.dock}</span>
          <div class="stg-info-row stg-info-row--dock-disabled">
            <span class="stg-info-key">{stg.size}</span>
            <div class="stg-slider-wrap">
              <span class="stg-slider-val" id="stg-dock-size-val">100%</span>
              <div class="stg-slider-track" id="stg-dock-slider">
                <div
                  class="stg-slider-fill"
                  id="stg-dock-slider-fill"
                  style="width: 33.33%;"
                >
                </div>
                <div
                  class="stg-slider-thumb"
                  id="stg-dock-slider-thumb"
                  style="left: 33.33%;"
                >
                </div>
              </div>
            </div>
          </div>
          <div class="stg-info-row stg-info-row--dock-disabled">
            <span class="stg-info-key">{stg.magnification}</span>
            <div class="stg-slider-wrap">
              <span class="stg-slider-val" id="stg-mag-val">25%</span>
              <div class="stg-slider-track" id="stg-mag-slider">
                <div
                  class="stg-slider-fill"
                  id="stg-mag-slider-fill"
                  style="width: 50%;"
                >
                </div>
                <div
                  class="stg-slider-thumb"
                  id="stg-mag-slider-thumb"
                  style="left: 50%;"
                >
                </div>
              </div>
            </div>
          </div>
          <div class="stg-info-row stg-info-row--dock-disabled">
            <span class="stg-info-key">{stg.autoHide}</span>
            <div class="stg-toggle" id="stg-autohide-toggle">
              <div class="stg-toggle-knob"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Wallpaper -->
      <div class="stg-panel" data-stg-panel="wallpaper">
        <span class="stg-content-title">{stg.wallpaper}</span>
        <div class="os-divider"></div>

        <!-- 1. Current -->
        <div class="stg-section">
          <span class="stg-section-label">{stg.current}</span>
          <div class="stg-wallpaper-preview" id="stg-wp-preview-wrap">
            <img
              id="stg-wp-current"
              src={defaultWallpaper.category === 'image'
                ? defaultWallpaper.src
                : ''}
              alt="Wallpaper"
              class="stg-wallpaper-img"
              style={defaultWallpaper.category !== 'image'
                ? 'display:none;'
                : ''}
            />
            <video
              id="stg-wp-current-video"
              class="stg-wallpaper-img"
              style={defaultWallpaper.category !== 'image'
                ? ''
                : 'display:none;'}
              src={defaultWallpaper.category !== 'image'
                ? defaultWallpaper.src
                : ''}
              muted
              loop
              playsinline></video>
          </div>
          <span class="stg-wallpaper-name" id="stg-wp-name"
            >{defaultWallpaper.name}</span
          >
          <!-- Wallpaper controls -->
          <div class="stg-wp-video-controls" id="stg-wp-video-controls">
            <div class="stg-info-row" id="stg-wp-mode-row">
              <span class="stg-info-key">{stg.mode}</span>
              <div class="stg-wp-mode-btns">
                <button class="stg-wp-mode-btn" data-wp-mode="frame">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><rect width="18" height="18" x="3" y="3" rx="2"
                    ></rect><path d="M12 3v18"></path></svg
                  >
                  {stg.frame}
                </button>
                <button
                  class="stg-wp-mode-btn stg-wp-mode-btn--active"
                  data-wp-mode="loop"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m17 2 4 4-4 4"></path><path
                      d="M3 11v-1a4 4 0 0 1 4-4h14"></path><path
                      d="m7 22-4-4 4-4"></path><path
                      d="M21 13v1a4 4 0 0 1-4 4H3"></path></svg
                  >
                  {stg.loop}
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Images -->
        <div class="stg-section">
          <span class="stg-section-label">{stg.images}</span>
          <div class="stg-wp-grid">
            {
              imageWallpapers.map((w) => (
                <button
                  class="stg-wp-thumb"
                  data-wp={w.src}
                  data-wp-name={w.name}
                  data-wp-category="image"
                >
                  <img src={w.src} alt={w.name} />
                </button>
              ))
            }
          </div>
        </div>

        <!-- 3. Silent videos -->
        {
          animationWallpapers.length > 0 && (
            <div class="stg-section">
              <span class="stg-section-label">{stg.animations}</span>
              <div class="stg-wp-grid">
                {animationWallpapers.map((w) => (
                  <button
                    class="stg-wp-thumb"
                    data-wp={w.src}
                    data-wp-name={w.name}
                    data-wp-category="animation"
                  >
                    <video
                      src={w.src}
                      muted
                      playsinline
                      preload="metadata"
                      class="stg-wp-thumb-video"
                    />
                  </button>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <!-- Date & Time -->
      <div class="stg-panel" data-stg-panel="datetime">
        <span class="stg-content-title">{stg.dateTime}</span>
        <div class="os-divider"></div>
        <!-- Mobile-only notice -->
        <div class="stg-mobile-note" id="stg-mobile-note" style="display:none;">
          <span>{stg.mobileClockNote}</span>
        </div>
        <div class="stg-section">
          <span class="stg-section-label">{stg.menuClock}</span>
          <div class="stg-info-row stg-info-row--mobile-disabled">
            <span class="stg-info-key">{stg.format24h}</span>
            <div class="stg-toggle" id="stg-24h-toggle">
              <div class="stg-toggle-knob"></div>
            </div>
          </div>
          <div class="stg-info-row stg-info-row--mobile-disabled">
            <span class="stg-info-key">{stg.showSeconds}</span>
            <div class="stg-toggle" id="stg-seconds-toggle">
              <div class="stg-toggle-knob"></div>
            </div>
          </div>
          <div class="stg-info-row stg-info-row--mobile-disabled">
            <span class="stg-info-key">{stg.showWeekday}</span>
            <div class="stg-toggle stg-toggle--on" id="stg-weekday-toggle">
              <div class="stg-toggle-knob"></div>
            </div>
          </div>
          <div class="stg-info-row stg-info-row--mobile-disabled">
            <span class="stg-info-key">{stg.showDate}</span>
            <div class="stg-toggle stg-toggle--on" id="stg-date-toggle">
              <div class="stg-toggle-knob"></div>
            </div>
          </div>
        </div>
        <div class="stg-section">
          <span class="stg-section-label">{stg.preview}</span>
          <div class="stg-clock-preview" id="stg-clock-preview"></div>
        </div>
      </div>

      <!-- Language & Region -->
      <div class="stg-panel" data-stg-panel="language">
        <span class="stg-content-title">{stg.languageRegion}</span>
        <div class="os-divider"></div>
        <div class="stg-section">
          <span class="stg-section-label">{stg.preferredLanguage}</span>
          <div class="stg-lang-list">
            {
              languages.map((lang) => (
                <button class="stg-lang-item" data-stg-lang={lang}>
                  <span class="stg-lang-badge">{lang.toUpperCase()}</span>
                  <span class="stg-lang-name">
                    {content.langSwitch?.langNames?.[lang] || lang}
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Accessibility -->
      <div class="stg-panel" data-stg-panel="accessibility">
        <span class="stg-content-title">{stg.navAccessibility}</span>
        <div class="os-divider"></div>

        <div class="stg-section">
          <span class="stg-section-label">{stg.display}</span>

          <!-- Font Size -->
          <div class="stg-info-row">
            <span class="stg-info-key">{stg.fontSize}</span>
            <div class="stg-font-size-btns" id="stg-font-size-btns">
              <button class="stg-font-btn" data-stg-fontsize="-1"
                >{stg.fontSizeSmall}</button
              >
              <button
                class="stg-font-btn stg-font-btn--active"
                data-stg-fontsize="0">{stg.fontSizeDefault}</button
              >
              <button class="stg-font-btn" data-stg-fontsize="1"
                >{stg.fontSizeLarge}</button
              >
              <button class="stg-font-btn" data-stg-fontsize="2"
                >{stg.fontSizeLargest}</button
              >
            </div>
          </div>
        </div>

        <div class="stg-section">
          <span class="stg-section-label">{stg.reduceMotion}</span>
          <div class="stg-info-row">
            <div class="stg-a11y-desc">
              <span class="stg-info-key">{stg.reduceMotion}</span>
              <span class="stg-info-desc">{stg.reduceMotionDesc}</span>
            </div>
            <div class="stg-toggle" id="stg-reduce-motion-toggle">
              <div class="stg-toggle-knob"></div>
            </div>
          </div>
        </div>

        <div class="stg-section">
          <span class="stg-section-label">{stg.highContrast}</span>
          <div class="stg-info-row">
            <div class="stg-a11y-desc">
              <span class="stg-info-key">{stg.highContrast}</span>
              <span class="stg-info-desc">{stg.highContrastDesc}</span>
            </div>
            <div class="stg-toggle" id="stg-high-contrast-toggle">
              <div class="stg-toggle-knob"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
