---
interface Props {
  class?: string;
}

const { class: cls = 'w-3.5 h-3.5' } = Astro.props;
---

<svg
  class:list={[cls, 'fill-none stroke-current']}
  stroke-width="2"
  viewBox="0 0 24 24"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <polyline points="4 17 10 11 4 5"></polyline>
  <line x1="12" y1="19" x2="20" y2="19"></line>
</svg>
