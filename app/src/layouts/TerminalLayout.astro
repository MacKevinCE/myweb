---
import '../styles/terminal.css';
import SEOHead from '../components/shared/SEOHead.astro';

interface Props {
  title: string;
  description: string;
  lang: string;
}

const { title, description, lang } = Astro.props;
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <SEOHead
      title={title}
      description={description}
      lang={lang}
      theme="terminal"
      themeColor="#0A0A0A"
    />

    <!-- JetBrains Mono + IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="h-full bg-[var(--bg-primary)] text-[var(--text-primary)] font-mono crt-container"
  >
    <slot />
  </body>
</html>
